---
// 상세 내용. 목록의 모달(ex 없음, 열 때 JS가 채움)과 예제별 페이지(ex 있음, 빌드 때 채움)가 같이 씀
import type { Example } from '../lib/types';
import { COST_LABEL } from '../lib/shared';
import Chips from './Chips.astro';
import Stage from './Stage.astro';

interface Props {
  ex?: Example;
}
const { ex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const descParts = ex ? ex.desc.split('`') : [];
const specRows = ex
  ? ([
    ['지속 시간', ex.spec.duration],
    ['Easing', ex.spec.easing],
    ['애니메이션 속성', ex.spec.props],
    ['렌더링 비용', COST_LABEL[ex.spec.cost]],
  ] as const).filter(([, value]) => value)
  : [];
---
<div class="detail-head">
  <div>
    <h2 id="detail-title">{ex?.title}</h2>
    <div class="chips" id="detail-chips">{ex && <Chips ex={ex} />}</div>
  </div>
  {ex
    ? <a class="detail-close" href={base}>전체 목록</a>
    : <button class="detail-close" type="button" id="detail-close">닫기</button>}
</div>
<div class="detail-grid">
  <div class="detail-stage">
    <div id="detail-stage-slot">{ex && <Stage ex={ex} suffix="detail" />}</div>
    <div class="playback">
      <button class="detail-replay" type="button" id="detail-replay">다시 재생</button>
      <div class="filter" role="group" aria-label="재생 속도" id="detail-speed">
        <button type="button" data-rate="1" aria-pressed="true">1x</button>
        <button type="button" data-rate="0.5" aria-pressed="false">0.5x</button>
        <button type="button" data-rate="0.25" aria-pressed="false">0.25x</button>
        <button type="button" data-rate="0.1" aria-pressed="false">0.1x</button>
        <button type="button" data-rate="0" aria-pressed="false">멈춤</button>
      </div>
    </div>
  </div>
  <div class="detail-info">
    <p id="detail-desc">{descParts.map((part, index) => (index % 2 === 0 ? part : <code>{part}</code>))}</p>
    <section class="tuner" id="detail-tuner" aria-labelledby="tuner-title" hidden={ex ? !ex.params : undefined}>
      <div class="tuner-head">
        <h3 id="tuner-title">값 조정</h3>
        <button class="tuner-reset" type="button" id="tuner-reset">기본값으로</button>
      </div>
      <div class="tuner-fields" id="tuner-fields"></div>
      <p class="tuner-note">바꾼 값은 아래 코드에 바로 반영됩니다.</p>
    </section>
    <dl class="spec" id="detail-spec">
      {specRows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
  </div>
</div>
<div class="code-block">
  <div class="code-bar">
    <div class="tabs" role="tablist" aria-label="코드 언어" id="detail-tabs"></div>
    <div class="code-actions">
      <button class="copy-btn" type="button" id="detail-prompt" title="조정한 값이 반영된 코드와 적용 규칙을 AI에게 붙여 넣을 문장으로 복사합니다">AI 프롬프트 복사</button>
      <button class="copy-btn" type="button" id="detail-copy">복사</button>
    </div>
  </div>
  <pre class="code-panel" role="tabpanel" id="detail-code" tabindex="0"><code></code></pre>
  <p class="code-caption" id="detail-caption" hidden><code>demo-</code>로 시작하는 클래스는 미리보기 모양을 위한 것이라 복사할 코드의 CSS에는 넣지 않았습니다.</p>
</div>
