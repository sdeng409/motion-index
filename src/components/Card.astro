---
import type { Example } from '../lib/types';
import { searchText } from '../lib/shared';
import Chips from './Chips.astro';
import Stage from './Stage.astro';

interface Props {
  ex: Example;
}
const { ex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<li data-id={ex.id} data-tag={ex.tag} data-kind={ex.kind} data-autoplay={ex.autoplay} data-hint={ex.hint} data-search={searchText(ex)}>
  <article class="card">
    <Stage ex={ex} suffix="thumb" />
    <div class="card-body">
      <h3 class="card-title"><a class="card-open" href={`${base}${ex.id}/`}>{ex.title}</a></h3>
      <p class="card-summary">{ex.summary}</p>
      <div class="chips"><Chips ex={ex} focusable={false} /></div>
    </div>
  </article>
</li>
